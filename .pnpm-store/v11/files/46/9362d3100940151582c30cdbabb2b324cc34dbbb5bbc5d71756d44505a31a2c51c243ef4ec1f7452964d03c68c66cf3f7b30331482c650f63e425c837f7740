{"version":3,"file":"download-ics-file.js","sourceRoot":"","sources":["../../../src/web/download-ics-file.ts"],"names":[],"mappings":"AAAA;;;;;;;;;;;;;;;;GAgBG;AACH,MAAM,CAAC,KAAK,UAAU,eAAe,CAAC,IAAU;IAC9C,IAAI,OAAO,QAAQ,KAAK,WAAW,IAAI,OAAO,GAAG,KAAK,WAAW,EAAE,CAAC;QAClE,MAAM,IAAI,KAAK,CAAC,0DAA0D,CAAC,CAAC;IAC9E,CAAC;IAED,MAAM,GAAG,GAAG,GAAG,CAAC,eAAe,CAAC,IAAI,CAAC,CAAC;IACtC,MAAM,IAAI,GAAG,QAAQ,CAAC,aAAa,CAAC,GAAG,CAAC,CAAC;IACzC,IAAI,CAAC,IAAI,GAAG,GAAG,CAAC;IAChB,IAAI,CAAC,QAAQ,GAAG,IAAI,CAAC,IAAI,CAAC,MAAM,GAAG,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,IAAI,CAAC,CAAC,CAAC,WAAW,CAAC;IAC/D,QAAQ,CAAC,IAAI,CAAC,WAAW,CAAC,IAAI,CAAC,CAAC;IAChC,IAAI,CAAC,KAAK,EAAE,CAAC;IACb,IAAI,CAAC,MAAM,EAAE,CAAC;IACd,qDAAqD;IACrD,MAAM,IAAI,OAAO,CAAC,CAAC,OAAO,EAAE,EAAE,CAAC,UAAU,CAAC,OAAO,EAAE,IAAI,CAAC,CAAC,CAAC;IAC1D,GAAG,CAAC,eAAe,CAAC,GAAG,CAAC,CAAC;AAC3B,CAAC","sourcesContent":["/**\n * Triggers a browser download for an `.ics` `File`.\n * Resolves after the object URL is revoked.\n *\n * @throws If `document` or `URL` is not available.\n *\n * @example\n * const { ics } = await CapacitorCalendar.createEvent({\n *   title: 'Team standup',\n *   icsFileName: 'team-standup.ics',\n * });\n * if (ics) {\n *   await downloadIcsFile(ics);\n * }\n *\n * @since 8.5.0\n */\nexport async function downloadIcsFile(file: File): Promise<void> {\n  if (typeof document === 'undefined' || typeof URL === 'undefined') {\n    throw new Error('downloadIcsFile requires a browser document environment.');\n  }\n\n  const url = URL.createObjectURL(file);\n  const link = document.createElement('a');\n  link.href = url;\n  link.download = file.name.length > 0 ? file.name : 'event.ics';\n  document.body.appendChild(link);\n  link.click();\n  link.remove();\n  // Delay revoke so the browser can start the download\n  await new Promise((resolve) => setTimeout(resolve, 1000));\n  URL.revokeObjectURL(url);\n}\n"]}